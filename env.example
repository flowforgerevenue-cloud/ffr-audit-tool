# FlowForge Revenue Diagnostic v3.0
# Optional persistent store for audit analytics and lead capture (if enabled).
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Server-side admin authentication
FFR_ADMIN_PASSWORD=change-this-in-vercel
FFR_TOKEN_SECRET=replace-with-64-hex-characters

# Crawl safety limits
FFR_MAX_PAGES=20
FFR_MAX_DEPTH=2
FFR_MAX_BODY_BYTES=2500000
FFR_CRAWL_TIMEOUT_MS=8000
